# Copy to .env and adjust. The server reads these on boot.

# Port the API listens on
PORT=4000

# Secret used to sign JWT session tokens. CHANGE THIS to a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# Invite code required to register a new account. Share it with your friends.
# Leave empty to allow open registration.
INVITE_CODE=roekoe-vrienden

# Comma-separated usernames that get admin rights (advance the week, run flights).
# The first registered user automatically becomes admin as well.
ADMIN_USERS=

# Where the JSON database file is stored (relative to repo root or absolute).
DATA_DIR=./data
